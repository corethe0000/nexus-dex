pragma solidity ^0.8.24;

/// @title SK256 of the Nexus core for a 32 byte input
/// @notice SHA3-256 (FIPS padding, not the EVM keccak256) of the core's own Skein-256-256 (src/LLC/hash/SK:
/// key schedule parity 0x5555..., old rotation constants). Output bytes in the order the core keeps them in memory.
library Sk256 {
    uint64 private constant ksParity = 0x5555555555555555;
    //Skein-256-256 chaining value after the config block (wallet skeinIv(256, 256))
    uint64 private constant iv0 = 0x388512680e660046;
    uint64 private constant iv1 = 0x4b72d5dec5a8ff01;
    uint64 private constant iv2 = 0x281a9298ca5eb3a5;
    uint64 private constant iv3 = 0x54ca5249f46070c4;
    uint64 private constant flagFirst = 1 << 62;
    uint64 private constant flagFinal = 1 << 63;
    uint64 private constant typeMsg = 48;
    uint64 private constant typeOut = 63;

    function hash(bytes32 data) internal pure returns (bytes32) {
        uint64[4] memory w = toWords(data);
        uint64[4] memory h = [iv0, iv1, iv2, iv3];
        h = ubi(h, w, 32, (typeMsg << 56) | flagFirst | flagFinal);
        uint64[4] memory zero;
        uint64[4] memory out = ubi(h, zero, 8, (typeOut << 56) | flagFirst | flagFinal);
        return sha3_256(out);
    }

    //little endian 64 bit words of the 32 bytes
    function toWords(bytes32 data) private pure returns (uint64[4] memory w) {
        for (uint256 i = 0; i < 4; i++) {
            uint64 v = 0;
            for (uint256 b = 0; b < 8; b++) {
                v |= uint64(uint8(data[i * 8 + b])) << uint64(8 * b);
            }
            w[i] = v;
        }
    }

    function rotl(uint64 x, uint64 r) private pure returns (uint64) {
        return (x << r) | (x >> (64 - r));
    }

    //Threefish-256 with feed forward of the plaintext
    function ubi(uint64[4] memory h, uint64[4] memory w, uint64 t0, uint64 t1) private pure returns (uint64[4] memory) {
        unchecked {
            uint64[5] memory ks = [h[0], h[1], h[2], h[3], ksParity ^ h[0] ^ h[1] ^ h[2] ^ h[3]];
            uint64[3] memory ts = [t0, t1, t0 ^ t1];
            uint64 x0 = w[0] + ks[0];
            uint64 x1 = w[1] + ks[1] + ts[0];
            uint64 x2 = w[2] + ks[2] + ts[1];
            uint64 x3 = w[3] + ks[3];
            for (uint64 s = 0; s < 18; s += 2) {
                //rounds 0-3 of 8: even rounds mix (0,1)(2,3), odd rounds (0,3)(2,1)
                x0 += x1; x1 = rotl(x1, 5) ^ x0; x2 += x3; x3 = rotl(x3, 56) ^ x2;
                x0 += x3; x3 = rotl(x3, 36) ^ x0; x2 += x1; x1 = rotl(x1, 28) ^ x2;
                x0 += x1; x1 = rotl(x1, 13) ^ x0; x2 += x3; x3 = rotl(x3, 46) ^ x2;
                x0 += x3; x3 = rotl(x3, 58) ^ x0; x2 += x1; x1 = rotl(x1, 44) ^ x2;
                x0 += ks[(s + 1) % 5];
                x1 += ks[(s + 2) % 5] + ts[(s + 1) % 3];
                x2 += ks[(s + 3) % 5] + ts[(s + 2) % 3];
                x3 += ks[(s + 4) % 5] + s + 1;
                //rounds 4-7
                x0 += x1; x1 = rotl(x1, 26) ^ x0; x2 += x3; x3 = rotl(x3, 20) ^ x2;
                x0 += x3; x3 = rotl(x3, 53) ^ x0; x2 += x1; x1 = rotl(x1, 35) ^ x2;
                x0 += x1; x1 = rotl(x1, 11) ^ x0; x2 += x3; x3 = rotl(x3, 42) ^ x2;
                x0 += x3; x3 = rotl(x3, 59) ^ x0; x2 += x1; x1 = rotl(x1, 50) ^ x2;
                x0 += ks[(s + 2) % 5];
                x1 += ks[(s + 3) % 5] + ts[(s + 2) % 3];
                x2 += ks[(s + 4) % 5] + ts[(s + 3) % 3];
                x3 += ks[(s + 5) % 5] + s + 2;
            }
            return [x0 ^ w[0], x1 ^ w[1], x2 ^ w[2], x3 ^ w[3]];
        }
    }

    //SHA3-256 (rate 136 bytes, domain suffix 0x06) of exactly 32 bytes given as 4 little endian words
    function sha3_256(uint64[4] memory m) private pure returns (bytes32) {
        uint64[25] memory a;
        a[0] = m[0];
        a[1] = m[1];
        a[2] = m[2];
        a[3] = m[3];
        a[4] = 0x06;
        a[16] = 0x8000000000000000;
        keccakF(a);
        uint256 r = 0;
        for (uint256 i = 0; i < 4; i++) {
            for (uint256 b = 0; b < 8; b++) {
                r = (r << 8) | ((a[i] >> uint64(8 * b)) & 0xff);
            }
        }
        return bytes32(r);
    }

    //generated by tools/gen-keccak.mjs --write: lanes of a at a + 32 * i, round constants in scratch memory
    function keccakF(uint64[25] memory a) private pure {
        assembly ("memory-safe") {
            function rol(x, r) -> y {
                y := and(or(shl(r, x), shr(sub(64, r), x)), 0xffffffffffffffff)
            }
            let p := a
            let rcs := mload(0x40)
            mstore(add(rcs, 0), 0x0000000000000001)
            mstore(add(rcs, 32), 0x0000000000008082)
            mstore(add(rcs, 64), 0x800000000000808a)
            mstore(add(rcs, 96), 0x8000000080008000)
            mstore(add(rcs, 128), 0x000000000000808b)
            mstore(add(rcs, 160), 0x0000000080000001)
            mstore(add(rcs, 192), 0x8000000080008081)
            mstore(add(rcs, 224), 0x8000000000008009)
            mstore(add(rcs, 256), 0x000000000000008a)
            mstore(add(rcs, 288), 0x0000000000000088)
            mstore(add(rcs, 320), 0x0000000080008009)
            mstore(add(rcs, 352), 0x000000008000000a)
            mstore(add(rcs, 384), 0x000000008000808b)
            mstore(add(rcs, 416), 0x800000000000008b)
            mstore(add(rcs, 448), 0x8000000000008089)
            mstore(add(rcs, 480), 0x8000000000008003)
            mstore(add(rcs, 512), 0x8000000000008002)
            mstore(add(rcs, 544), 0x8000000000000080)
            mstore(add(rcs, 576), 0x000000000000800a)
            mstore(add(rcs, 608), 0x800000008000000a)
            mstore(add(rcs, 640), 0x8000000080008081)
            mstore(add(rcs, 672), 0x8000000000008080)
            mstore(add(rcs, 704), 0x0000000080000001)
            mstore(add(rcs, 736), 0x8000000080008008)
            for { let round := 0 } lt(round, 24) { round := add(round, 1) } {
                let c0 := xor(xor(xor(mload(p), mload(add(p, 160))), xor(mload(add(p, 320)), mload(add(p, 480)))), mload(add(p, 640)))
                let c1 := xor(xor(xor(mload(add(p, 32)), mload(add(p, 192))), xor(mload(add(p, 352)), mload(add(p, 512)))), mload(add(p, 672)))
                let c2 := xor(xor(xor(mload(add(p, 64)), mload(add(p, 224))), xor(mload(add(p, 384)), mload(add(p, 544)))), mload(add(p, 704)))
                let c3 := xor(xor(xor(mload(add(p, 96)), mload(add(p, 256))), xor(mload(add(p, 416)), mload(add(p, 576)))), mload(add(p, 736)))
                let c4 := xor(xor(xor(mload(add(p, 128)), mload(add(p, 288))), xor(mload(add(p, 448)), mload(add(p, 608)))), mload(add(p, 768)))
                {
                    let d := xor(c4, rol(c1, 1))
                    mstore(p, xor(mload(p), d))
                    mstore(add(p, 160), xor(mload(add(p, 160)), d))
                    mstore(add(p, 320), xor(mload(add(p, 320)), d))
                    mstore(add(p, 480), xor(mload(add(p, 480)), d))
                    mstore(add(p, 640), xor(mload(add(p, 640)), d))
                }
                {
                    let d := xor(c0, rol(c2, 1))
                    mstore(add(p, 32), xor(mload(add(p, 32)), d))
                    mstore(add(p, 192), xor(mload(add(p, 192)), d))
                    mstore(add(p, 352), xor(mload(add(p, 352)), d))
                    mstore(add(p, 512), xor(mload(add(p, 512)), d))
                    mstore(add(p, 672), xor(mload(add(p, 672)), d))
                }
                {
                    let d := xor(c1, rol(c3, 1))
                    mstore(add(p, 64), xor(mload(add(p, 64)), d))
                    mstore(add(p, 224), xor(mload(add(p, 224)), d))
                    mstore(add(p, 384), xor(mload(add(p, 384)), d))
                    mstore(add(p, 544), xor(mload(add(p, 544)), d))
                    mstore(add(p, 704), xor(mload(add(p, 704)), d))
                }
                {
                    let d := xor(c2, rol(c4, 1))
                    mstore(add(p, 96), xor(mload(add(p, 96)), d))
                    mstore(add(p, 256), xor(mload(add(p, 256)), d))
                    mstore(add(p, 416), xor(mload(add(p, 416)), d))
                    mstore(add(p, 576), xor(mload(add(p, 576)), d))
                    mstore(add(p, 736), xor(mload(add(p, 736)), d))
                }
                {
                    let d := xor(c3, rol(c0, 1))
                    mstore(add(p, 128), xor(mload(add(p, 128)), d))
                    mstore(add(p, 288), xor(mload(add(p, 288)), d))
                    mstore(add(p, 448), xor(mload(add(p, 448)), d))
                    mstore(add(p, 608), xor(mload(add(p, 608)), d))
                    mstore(add(p, 768), xor(mload(add(p, 768)), d))
                }
                let t := mload(add(p, 32))
                { let bc := mload(add(p, 320)) mstore(add(p, 320), rol(t, 1)) t := bc }
                { let bc := mload(add(p, 224)) mstore(add(p, 224), rol(t, 3)) t := bc }
                { let bc := mload(add(p, 352)) mstore(add(p, 352), rol(t, 6)) t := bc }
                { let bc := mload(add(p, 544)) mstore(add(p, 544), rol(t, 10)) t := bc }
                { let bc := mload(add(p, 576)) mstore(add(p, 576), rol(t, 15)) t := bc }
                { let bc := mload(add(p, 96)) mstore(add(p, 96), rol(t, 21)) t := bc }
                { let bc := mload(add(p, 160)) mstore(add(p, 160), rol(t, 28)) t := bc }
                { let bc := mload(add(p, 512)) mstore(add(p, 512), rol(t, 36)) t := bc }
                { let bc := mload(add(p, 256)) mstore(add(p, 256), rol(t, 45)) t := bc }
                { let bc := mload(add(p, 672)) mstore(add(p, 672), rol(t, 55)) t := bc }
                { let bc := mload(add(p, 768)) mstore(add(p, 768), rol(t, 2)) t := bc }
                { let bc := mload(add(p, 128)) mstore(add(p, 128), rol(t, 14)) t := bc }
                { let bc := mload(add(p, 480)) mstore(add(p, 480), rol(t, 27)) t := bc }
                { let bc := mload(add(p, 736)) mstore(add(p, 736), rol(t, 41)) t := bc }
                { let bc := mload(add(p, 608)) mstore(add(p, 608), rol(t, 56)) t := bc }
                { let bc := mload(add(p, 416)) mstore(add(p, 416), rol(t, 8)) t := bc }
                { let bc := mload(add(p, 384)) mstore(add(p, 384), rol(t, 25)) t := bc }
                { let bc := mload(add(p, 64)) mstore(add(p, 64), rol(t, 43)) t := bc }
                { let bc := mload(add(p, 640)) mstore(add(p, 640), rol(t, 62)) t := bc }
                { let bc := mload(add(p, 448)) mstore(add(p, 448), rol(t, 18)) t := bc }
                { let bc := mload(add(p, 704)) mstore(add(p, 704), rol(t, 39)) t := bc }
                { let bc := mload(add(p, 288)) mstore(add(p, 288), rol(t, 61)) t := bc }
                { let bc := mload(add(p, 192)) mstore(add(p, 192), rol(t, 20)) t := bc }
                { let bc := mload(add(p, 32)) mstore(add(p, 32), rol(t, 44)) t := bc }
                c0 := mload(p)
                c1 := mload(add(p, 32))
                c2 := mload(add(p, 64))
                c3 := mload(add(p, 96))
                c4 := mload(add(p, 128))
                mstore(p, xor(c0, and(not(c1), c2)))
                mstore(add(p, 32), xor(c1, and(not(c2), c3)))
                mstore(add(p, 64), xor(c2, and(not(c3), c4)))
                mstore(add(p, 96), xor(c3, and(not(c4), c0)))
                mstore(add(p, 128), xor(c4, and(not(c0), c1)))
                c0 := mload(add(p, 160))
                c1 := mload(add(p, 192))
                c2 := mload(add(p, 224))
                c3 := mload(add(p, 256))
                c4 := mload(add(p, 288))
                mstore(add(p, 160), xor(c0, and(not(c1), c2)))
                mstore(add(p, 192), xor(c1, and(not(c2), c3)))
                mstore(add(p, 224), xor(c2, and(not(c3), c4)))
                mstore(add(p, 256), xor(c3, and(not(c4), c0)))
                mstore(add(p, 288), xor(c4, and(not(c0), c1)))
                c0 := mload(add(p, 320))
                c1 := mload(add(p, 352))
                c2 := mload(add(p, 384))
                c3 := mload(add(p, 416))
                c4 := mload(add(p, 448))
                mstore(add(p, 320), xor(c0, and(not(c1), c2)))
                mstore(add(p, 352), xor(c1, and(not(c2), c3)))
                mstore(add(p, 384), xor(c2, and(not(c3), c4)))
                mstore(add(p, 416), xor(c3, and(not(c4), c0)))
                mstore(add(p, 448), xor(c4, and(not(c0), c1)))
                c0 := mload(add(p, 480))
                c1 := mload(add(p, 512))
                c2 := mload(add(p, 544))
                c3 := mload(add(p, 576))
                c4 := mload(add(p, 608))
                mstore(add(p, 480), xor(c0, and(not(c1), c2)))
                mstore(add(p, 512), xor(c1, and(not(c2), c3)))
                mstore(add(p, 544), xor(c2, and(not(c3), c4)))
                mstore(add(p, 576), xor(c3, and(not(c4), c0)))
                mstore(add(p, 608), xor(c4, and(not(c0), c1)))
                c0 := mload(add(p, 640))
                c1 := mload(add(p, 672))
                c2 := mload(add(p, 704))
                c3 := mload(add(p, 736))
                c4 := mload(add(p, 768))
                mstore(add(p, 640), xor(c0, and(not(c1), c2)))
                mstore(add(p, 672), xor(c1, and(not(c2), c3)))
                mstore(add(p, 704), xor(c2, and(not(c3), c4)))
                mstore(add(p, 736), xor(c3, and(not(c4), c0)))
                mstore(add(p, 768), xor(c4, and(not(c0), c1)))
                mstore(p, xor(mload(p), mload(add(rcs, mul(round, 32)))))
            }
        }
    }
}
